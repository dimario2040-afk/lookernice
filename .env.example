TELEGRAM_TOKEN=PASTE_TOKEN_FROM_BOTFATHER
# --- ВОДОПАД бесплатных VLM: первый живой отдаёт ответ, остальные — резерв ---
# 1) Groq (проверено: работает, быстрый) — https://console.groq.com/keys
#    vision-модель: qwen/qwen3.8-27b
GROQ_API_KEY=PASTE_KEY_FROM_GROQ
# GROQ_MODELS=qwen/qwen3.8-27b
# 2) Google AI Studio (gemini, без карты; из РФ блок по региону, на Render — ок)
# GEMINI_API_KEY=PASTE_KEY_FROM_GOOGLE_AI_STUDIO
# 3) z.ai / Zhipu (glm-4.6v-flash — бесплатная vision, часто 429)
MODEL_API_KEY=PASTE_KEY_FROM_ZAI
# 4) AIHubMix (агрегатор, OpenAI-совместимый; нужен баланс)
# AIHUBMIX_API_KEY=PASTE_KEY_FROM_AIHUBMIX
# 5) Alibaba DashScope — дешёвый Qwen-VL, работает из РФ
# DASHSCOPE_API_KEY=PASTE_KEY_FROM_DASHSCOPE
# DASHSCOPE_MODELS=qwen-vl-plus,qwen-vl-max
# 6) OpenRouter (один ключ, бесплатные vision-модели, без карты): https://openrouter.ai/keys
# OPENROUTER_API_KEY=PASTE_KEY_FROM_OPENROUTER

# опционально (показаны дефолты):
# MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL_NAME=glm-4.6v-flash
# MODEL_FALLBACKS=glm-4.6v-flash
# VLM_TIMEOUT=12      # сек на одну попытку
# VLM_DEADLINE=30     # сек бюджет на всё фото (водопад целиком)

# --- деплой на Render (локально не нужно) ---
# RENDER_EXTERNAL_URL=https://твой-сервис.onrender.com  (на Render задаётся само)
# WEBHOOK_SECRET=длинная-случайная-строка
# PORT=8080  (на Render задаётся само)
